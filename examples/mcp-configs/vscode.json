{
  "inputs": [
    {
      "type": "promptString",
      "id": "docbrain-api-key",
      "description": "DocBrain API key",
      "password": true
    }
  ],
  "servers": {
    "docbrain": {
      "type": "http",
      "url": "http://localhost:3001/api/v1/mcp",
      "headers": {
        "Authorization": "Bearer ${input:docbrain-api-key}"
      }
    }
  }
}
