# ═══════════════════════════════════════════════════════════════════════════
# DocBrain Configuration
# Copy this to .env and fill in your values: cp .env.example .env
#
# How configuration works:
#   YAML defaults are baked into the Docker image (config/default.yaml +
#   config/production.yaml). You only need .env for secrets and values
#   specific to your deployment. Environment variables always win over YAML.
# ═══════════════════════════════════════════════════════════════════════════

# ── Infrastructure ────────────────────────────────────────────────────────
POSTGRES_USER=docbrain
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=docbrain
# DATABASE_URL is set automatically by docker-compose.yml — override only if using an external DB
# DATABASE_URL=postgresql://docbrain:change-me-in-production@postgres:5432/docbrain

OPENSEARCH_URL=http://opensearch:9200
REDIS_URL=redis://redis:6379

# ── LLM Provider (choose one: bedrock | anthropic | openai | ollama) ─────
#
# OPTION A: AWS Bedrock (recommended for teams on AWS — uses existing credentials)
#   Requires: AWS credentials (env vars, ~/.aws/credentials, or instance profile)
#   Enable models in: https://console.aws.amazon.com/bedrock/home#/modelaccess
#
LLM_PROVIDER=bedrock
LLM_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0
EMBED_PROVIDER=bedrock
EMBED_MODEL_ID=cohere.embed-v4:0
AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=              # Optional — uses default credential chain if unset
# AWS_SECRET_ACCESS_KEY=
#
# OPTION B: Anthropic + OpenAI (best quality)
#   Requires: ANTHROPIC_API_KEY + OPENAI_API_KEY
#
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# LLM_MODEL_ID=claude-sonnet-4-5-20250929
# EMBED_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# EMBED_MODEL_ID=text-embedding-3-small
#
# OPTION C: OpenAI only (single API key)
#   Requires: OPENAI_API_KEY
#
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# LLM_MODEL_ID=gpt-4o
# EMBED_PROVIDER=openai
# EMBED_MODEL_ID=text-embedding-3-small
#
# OPTION D: 100% Local with Ollama (no API keys, no data leaves your machine)
#   Requires: Ollama running locally (ollama pull <model> && ollama pull nomic-embed-text)
#   IMPORTANT: Only use models with strong instruction-following for RAG.
#   Recommended: command-r:35b (purpose-built for RAG, best grounding quality).
#   Alternative: qwen2.5:32b. Avoid models that ignore grounding instructions (e.g. llama3.1:70b
#   defaults to training data instead of retrieved docs, producing fabricated answers).
#   8B models will hallucinate — use qwen2.5:7b ONLY as FAST_MODEL_ID for intent/rewrite.
#
# LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=http://host.docker.internal:11434
# LLM_MODEL_ID=command-r:35b
# FAST_MODEL_ID=qwen2.5:7b         # optional: use 7B for intent/rewrite; only final answer uses primary model
# OLLAMA_TIMEOUT_SECS=300           # optional: increase for large models to avoid "error decoding response body" after 2+ min
# EMBED_PROVIDER=ollama
# EMBED_MODEL_ID=nomic-embed-text
# OLLAMA_TLS_VERIFY=false          # Set to true to enforce TLS certificate validation
# OLLAMA_VISION_ENABLED=true       # Set to false if your Ollama model does not support vision

# ── Document Sources ──────────────────────────────────────────────────────
# Ingestion sources live under the `sources:` umbrella in config YAML. Each
# provider has one config block with optional sub-sources (code, pull_requests,
# merge_requests, threads). A sub-source runs when its block is present in
# YAML. Resource lists (repos, projects, channels, teams, …) must always be
# non-empty — there is no "ingest everything the token can see" fallback.
#
# Scalar secrets (tokens, credentials) can come from env vars below. Resource
# lists must live in config/local.yaml (gitignored) since env vars can only
# carry single values. See docs/configuration.md for the full shape.
#
# Local filesystem — one path, no credentials
LOCAL_DOCS_PATH=/data/docs

# Confluence (flat shape, legacy — not nested under `sources:`)
# CONFLUENCE_BASE_URL=https://your-domain.atlassian.net/wiki
# CONFLUENCE_USER_EMAIL=
# CONFLUENCE_API_TOKEN=
# CONFLUENCE_SPACE_KEYS=DOCS,ENG
# CONFLUENCE_API_VERSION=v2          # v2 for Cloud (default), v1 for self-hosted Data Center 7.x+
# CONFLUENCE_PAGE_LIMIT=0            # Max pages to ingest per space (0 = unlimited, default)
# CONFLUENCE_TLS_VERIFY=true         # Set to false if using self-signed or internal CA certs

# GitHub — sources.github.*
# GITHUB_TOKEN=                       # repo:read scope, powers sources.github.code and sources.github.pull_requests
# GITHUB_API_URL=                     # Override for GitHub Enterprise (default: https://api.github.com)

# GitLab — sources.gitlab.*
# GITLAB_TOKEN=                       # api scope, powers sources.gitlab.merge_requests
# GITLAB_BASE_URL=                    # Override for self-hosted (default: https://gitlab.com)
# GITLAB_TLS_VERIFY=true              # Set to false for self-signed certs

# Slack ingest — sources.slack.*
# SLACK_INGEST_TOKEN=xoxb-...         # Bot token with channels:history, channels:read, users:read (SEPARATE from SLACK_BOT_TOKEN)

# Jira — sources.jira.*
# JIRA_BASE_URL=https://acme.atlassian.net
# JIRA_USER_EMAIL=
# JIRA_API_TOKEN=

# Linear — sources.linear.*
# LINEAR_API_KEY=

# PagerDuty — sources.pagerduty.*
# PAGERDUTY_API_TOKEN=

# OpsGenie — sources.opsgenie.*
# OPSGENIE_API_KEY=

# Zendesk — sources.zendesk.*
# ZENDESK_SUBDOMAIN=                  # acme (before .zendesk.com)
# ZENDESK_EMAIL=
# ZENDESK_API_TOKEN=

# Intercom — sources.intercom.*
# INTERCOM_ACCESS_TOKEN=

# Microsoft Teams — sources.ms_teams.*
# MS_TEAMS_TENANT_ID=
# MS_TEAMS_CLIENT_ID=
# MS_TEAMS_CLIENT_SECRET=

# ── Embedding Model Switch ──────────────────────────────────────────────
# When switching embedding providers/models (e.g. Bedrock→Ollama), the vector
# dimensions may change. The server will refuse to start if dimensions don't match.
# Set FORCE_REINDEX=true ONE TIME to delete and recreate the OpenSearch indexes,
# then run ingest to re-embed all documents. Remove/unset after the migration.
# FORCE_REINDEX=true

# ── Optional Features ────────────────────────────────────────────────────
# LLM_THINKING_BUDGET=10000          # Extended thinking token budget (0 = disabled)
# HAIKU_MODEL_ID=                    # Override the fast/cheap model used for image descriptions

# ── Image Extraction ─────────────────────────────────────────────────────
# Extracts and describes images from Confluence pages using vision LLM.
# IMAGE_EXTRACTION_ENABLED=true      # Set to false to disable image extraction entirely
# IMAGE_MAX_PER_PAGE=20              # Max images to process per Confluence page
# IMAGE_MIN_SIZE_BYTES=5120          # Skip images smaller than this (bytes, default: 5KB)
# IMAGE_MAX_SIZE_BYTES=10485760      # Skip images larger than this (bytes, default: 10MB)
# IMAGE_DOWNLOAD_TIMEOUT=30          # HTTP download timeout in seconds
# IMAGE_LLM_TIMEOUT=120              # LLM vision call timeout in seconds

# ── Slack Integration ────────────────────────────────────────────────────
# Required OAuth scopes for the Slack bot token:
#   channels:history     — read channel message history (needed for thread capture)
#   channels:read        — list channels
#   chat:write           — post answers and capture confirmations
#   commands             — receive /docbrain slash commands
#   users:read           — resolve user display names in threads
#   app_mentions:read    — receive @DocBrain capture mentions in threads
#   users:read.email     — look up doc authors by email for stale-doc DMs
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_SIGNING_SECRET=

# Channel to post critical gap alerts after each analysis run (e.g. #docs-alerts).
# Only fires when new critical-severity gaps are found. Requires SLACK_BOT_TOKEN.
# SLACK_GAP_NOTIFICATION_CHANNEL=#docs-alerts

# Stale doc notifications — sends DMs to doc owners (requires Slack)
# NOTIFICATION_INTERVAL_HOURS=24
# NOTIFICATION_SPACE_FILTER=PLATFORM,SRE  # optional: limit to specific spaces

# ── GitHub Real-Time Capture ─────────────────────────────────────────────
# Enables `@docbrain capture` on any GitHub PR or issue comment.
# When a comment contains "@docbrain capture", DocBrain fetches the full thread
# and generates an Autopilot draft immediately.
#
# Setup (one-time, per repo):
#   GitHub repo → Settings → Webhooks → Add webhook
#     Payload URL:  https://your-docbrain-host/github/events
#     Content type: application/json
#     Secret:       <same value as GITHUB_WEBHOOK_SECRET below>
#     Events:       Issue comments, Pull request review comments
#
# Required token scopes: repo (read) + write:discussion
# GITHUB_WEBHOOK_SECRET=           # HMAC secret — must match the webhook secret above
# GITHUB_BOT_TOKEN=ghp_...         # Token to post capture confirmation replies

# ── Documentation Autopilot (gap analysis + draft generation) ────────────
# AUTOPILOT_ENABLED=false
# AUTOPILOT_GAP_ANALYSIS_INTERVAL_HOURS=6   # How often the background scheduler runs
# AUTOPILOT_LOOKBACK_DAYS=30                # Days of query history to analyse for gaps
# AUTOPILOT_CLUSTER_THRESHOLD=0.82          # Cosine similarity for clustering (0.65=loose, 0.85=strict)
# AUTOPILOT_MIN_CLUSTER_SIZE=3              # Min episodes in a cluster to consider it a gap
# AUTOPILOT_MIN_UNIQUE_USERS=2              # Min distinct users that must hit the same gap
# AUTOPILOT_MIN_NEGATIVE_RATIO=0.15         # Min fraction of queries on a topic that must be negative
# AUTOPILOT_MAX_CLUSTERS=50                 # Max gap clusters to persist per analysis run
# AUTOPILOT_MAX_EPISODES=500                # Max negative episodes to load per run

# ── Freshness Scoring ─────────────────────────────────────────────────────
# FRESHNESS_SCHEDULER_INTERVAL_HOURS=24     # How often freshness scores are recalculated
# CONTRADICTION_CHECKS_PER_PASS=10          # Max docs checked for contradictions per run (LLM cost)
# CONTRADICTION_INCLUDE_RECENT_EVENT_DOCS=true   # Include recent Slack/PR/Jira docs in contradiction pass
# CONTRADICTION_EVENT_DOC_MAX_AGE_DAYS=90        # Only event-based docs within N days are eligible

# ── Semantic Quality Scoring ─────────────────────────────────────────────
# SEMANTIC_QUALITY_ENABLED=true           # Enable LLM-based semantic quality scoring
# SEMANTIC_QUALITY_INTERVAL_HOURS=24      # How often the semantic sweep runs
# SEMANTIC_QUALITY_BUDGET=50              # Max documents scored per sweep (LLM cost control)
# SEMANTIC_QUALITY_STRUCTURAL_THRESHOLD=40.0  # Min structural score to be eligible for semantic scoring

# ── Memory Consolidation ──────────────────────────────────────────────────
# CONSOLIDATION_INTERVAL_HOURS=6            # How often the memory consolidation job runs

# ── Learning Pipeline (Tier 2 — disabled by default) ─────────────────────
# Uncomment the trainer block in docker-compose.yml first, then set these.
# See docs/learning.md for full setup.
# LEARNING_ENABLED=true
# EMBED_PROVIDER=local                      # Use the fine-tuned local model
# TRAINER_URL=http://trainer:8765           # Internal Docker service URL
# TRAINER_API_KEY=                          # Shared secret — generate: openssl rand -hex 32

# ── Data Retention ────────────────────────────────────────────────────────
# EPISODE_RETENTION_DAYS=90                 # Episode (query history) retention. Set to 0 to disable.
# AUDIT_RETENTION_DAYS=365                  # Audit log retention. Set to 0 to disable.

# ── RAG Pipeline ──────────────────────────────────────────────────────────
# RAG_TOP_K=10                              # Chunks retrieved per query (raise if answers miss context, lower to reduce token cost)
# RAG_BM25_BOOST=1.0                        # BM25 keyword weight vs vector search (raise to 2-3 for error codes / CLI commands)

# ── Five-stage retrieval pipeline (opt-in via RAG_RERANK_PROVIDER) ────
# Default is "none" → legacy single-hybrid-search path runs unchanged.
# Set to "bedrock" (or another enabled provider) to activate:
#   - candidate generation with RRF fusion over multiple retrievers
#   - cross-encoder semantic reranking
#   - diversity + coverage constraints on the final top-k
#   - confidence floor before the LLM sees noise
# Rollback = flip this back to "none". No rebuild, no migration.
# RAG_RERANK_PROVIDER=none                    # none | bedrock | cohere | voyage | jina | ollama
# RAG_RERANK_MODEL_ID=                        # provider-specific default if unset
# RAG_RERANK_TOP_N=200                        # candidates scored per query
# RAG_RERANK_BATCH_SIZE=100                   # docs per reranker API call
# RAG_RERANK_TIMEOUT_SECS=10                  # per-call timeout (hot-path, keep tight)
# COHERE_RERANK_API_KEY=                      # required when provider=cohere
# VOYAGE_API_KEY=                             # required when provider=voyage
# JINA_API_KEY=                               # required when provider=jina
# RAG_RERANK_OLLAMA_BASE_URL=                 # defaults to llm.ollama_base_url

# Pipeline knobs — every value configurable, zero hardcoding:
# RAG_CANDIDATE_POOL_SIZE=200                 # pool size fed to reranker
# RAG_RRF_K=60                                # RRF damping constant (canonical paper)
# RAG_MAX_PER_SOURCE=3                        # per-source cap in final top-k
# RAG_MAX_PER_DOCUMENT=2                      # per-document cap in final top-k
# RAG_MIN_RELEVANCE_SCORE=0.30                # retrieval floor — drop below this from diversity
# RAG_DISPLAY_FLOOR=0.30                      # display floor — drop below this from sources array
# RAG_CONFIDENCE_GATE=0.30                    # confidence gate — hide all sources below this confidence
# RAG_STRONG_ANSWER_FLOOR=0.50                # high-confidence answer threshold
# RAG_FRESHNESS_WINDOW_DAYS=7                 # freshness retriever window (0 to disable)
# RAG_FRESHNESS_PRE_DIVERSITY=true            # apply freshness BEFORE diversity (recommended)
# RAG_ENTITY_CACHE_TTL_SECS=300               # entity → space cache TTL
# RAG_MAX_REWRITES=2                          # query rewrites per ask (0 to disable)
# RAG_RERANK_TITLE_ENRICH=true                # pass title+heading+space to reranker (recommended)
# RAG_TRACE_DETAIL=false                      # log per-chunk rerank output in final top-k
# SEARCH_MIN_SCORE=0.0                      # Drop chunks below this score (0.3-0.4 filters noise; 0.0 keeps all)
# RAG_CACHE_TTL_HOURS=24                    # How long to cache semantically identical answers
# RAG_CACHE_THRESHOLD=0.95                  # Cosine similarity threshold for cache hits

# ── OpenSearch Index Names ────────────────────────────────────────────────
# Only needed if you run multiple DocBrain instances sharing the same OpenSearch cluster.
# OPENSEARCH_INDEX=docbrain-chunks
# OPENSEARCH_EPISODE_INDEX=docbrain-episodes

# ── Server ────────────────────────────────────────────────────────────────
# SERVER_PORT=3000
# WEB_PORT=3001
# LOG_LEVEL=info                     # trace | debug | info | warn | error
# MAX_QUERY_LENGTH=4000              # Max chars for question/description inputs

# ── Web UI / CORS ─────────────────────────────────────────────────────────
# Set to your web UI domain in production (e.g. https://docbrain.yourco.com)
# CORS_ALLOWED_ORIGINS=http://localhost:3001

# ── Auth / Sessions ───────────────────────────────────────────────────────
# LOGIN_SESSION_TTL_HOURS=720        # Session lifetime (default: 720h = 30 days, 0 = no expiry)

# ── Event Bus ──────────────────────────────────────────────────────────────
# Internal pub/sub for all significant system actions. Always enabled.
# EVENT_BUS_CAPACITY=4096              # Broadcast channel buffer size (max: 65536)
# EVENT_LOG_RETENTION_DAYS=90          # Days to retain events in event_log table

# ── Knowledge Fragments ──────────────────────────────────────────────────
# Confidence-based routing for captured knowledge fragments.
# FRAGMENT_AUTO_INDEX_THRESHOLD=0.7    # Min confidence to auto-index into search
# FRAGMENT_REVIEW_THRESHOLD=0.4       # Min confidence for review queue; below = discard
# FRAGMENT_MAX_CONTENT_LENGTH=10000   # Max fragment content length in characters

# ── Self-Ingest ────────────────────────────────────────────────────────────
# Auto-ingest DocBrain's own docs so it can answer configuration questions about itself.
# DOCBRAIN_SELF_INGEST=false
# DOCBRAIN_DOCS_PATH=./docs

# ── SSO / OIDC (Enterprise) ───────────────────────────────────────────────
# OIDC_ISSUER_URL=                   # e.g. https://accounts.google.com
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URI=http://localhost:3000/api/v1/auth/oidc/callback
