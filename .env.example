# ═══════════════════════════════════════════════════════════════════════════
# DocBrain Configuration
# Copy this to .env and fill in your values: cp .env.example .env
#
# How configuration works:
#   YAML defaults are baked into the Docker image (config/default.yaml +
#   config/production.yaml). You only need .env for secrets and values
#   specific to your deployment. Environment variables always win over YAML.
# ═══════════════════════════════════════════════════════════════════════════

# ── Infrastructure ────────────────────────────────────────────────────────
POSTGRES_USER=docbrain
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=docbrain
# DATABASE_URL is set automatically by docker-compose.yml — override only if using an external DB
# DATABASE_URL=postgresql://docbrain:change-me-in-production@postgres:5432/docbrain

OPENSEARCH_URL=http://opensearch:9200
REDIS_URL=redis://redis:6379

# ── Fingerprint key ───────────────────────────────────────────────────────
# Keys the fingerprints DocBrain stores for secret findings, so a database or backup reader
# cannot guess a found value. Leave it empty and Docker Compose generates one on first start
# into the docbrain-keys volume (back that volume up, separately from the database backups).
# Or supply your own here (it wins over the generated one): at least 32 random bytes, hex or
# base64, e.g. openssl rand -base64 32. Never change it casually: a changed key reopens every
# restored or declined finding.
DOCBRAIN_FINGERPRINT_KEY=

# ── LLM Provider (choose one: bedrock | anthropic | openai | ollama) ─────
#
# OPTION A: AWS Bedrock (recommended for teams on AWS — uses existing credentials)
#   Requires: AWS credentials (env vars, ~/.aws/credentials, or instance profile)
#   Enable models in: https://console.aws.amazon.com/bedrock/home#/modelaccess
#
LLM_PROVIDER=bedrock
LLM_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0
EMBED_PROVIDER=bedrock
EMBED_MODEL_ID=cohere.embed-v4:0
AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=              # Optional — uses default credential chain if unset
# AWS_SECRET_ACCESS_KEY=
#
# OPTION B: Anthropic + OpenAI (best quality)
#   Requires: ANTHROPIC_API_KEY + OPENAI_API_KEY
#
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# LLM_MODEL_ID=claude-sonnet-4-5-20250929
# EMBED_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# EMBED_MODEL_ID=text-embedding-3-small
#
# OPTION C: OpenAI only (single API key)
#   Requires: OPENAI_API_KEY
#
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# LLM_MODEL_ID=gpt-4o
# EMBED_PROVIDER=openai
# EMBED_MODEL_ID=text-embedding-3-small
#
# OPTION D: 100% Local with Ollama (no API keys, no data leaves your machine)
#   Requires: Ollama running locally (ollama pull <model> && ollama pull nomic-embed-text)
#   IMPORTANT: Only use models with strong instruction-following for RAG.
#   Recommended: command-r:35b (purpose-built for RAG, best grounding quality).
#   Alternative: qwen2.5:32b. Avoid models that ignore grounding instructions (e.g. llama3.1:70b
#   defaults to training data instead of retrieved docs, producing fabricated answers).
#   8B models will hallucinate — use qwen2.5:7b ONLY as FAST_MODEL_ID for intent/rewrite.
#
#   SET FAST_MODEL_ID TO A DIFFERENT MODEL THAN LLM_MODEL_ID. On one GPU this is not a
#   tuning preference, it is what keeps side-calls from serialising: Ollama runs one
#   request at a time per model, so if the two ids are equal (or FAST_MODEL_ID is unset)
#   every intent/rewrite/tool-argument call queues behind whatever synthesis is doing.
#   Measured 2026-09-06 with both set to qwen2.5:14b-instruct: an MCP argument-builder
#   call needing ~8s of GPU waited over 30s and timed out the whole tool dispatch, so
#   live-tool answers silently fell back to documentation. Pointing FAST_MODEL_ID at
#   qwen2.5:7b-instruct gave it its own slot and the same call finished in 9.5s.
#   Cost: both models stay resident (~11GB + ~4.7GB for that pair), so size the host
#   accordingly and make sure Ollama is allowed to keep both loaded at once.
#   A smaller fast model is FASTER, not smarter — in the same test the 7B chose a less
#   appropriate tool than the 14B did. Use it for the side-calls it is meant for and
#   leave the final answer to LLM_MODEL_ID.
#
# LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=http://host.docker.internal:11434
# LLM_MODEL_ID=command-r:35b
# FAST_MODEL_ID=qwen2.5:7b         # MUST differ from LLM_MODEL_ID on a single GPU — see above
# FAST_LLM_PROVIDER=               # optional: run FAST_MODEL_ID on a different provider than
#                                  # LLM_PROVIDER (bedrock/vertex_ai refused; defaults to LLM_PROVIDER)
# OLLAMA_TIMEOUT_SECS=300           # optional: increase for large models to avoid "error decoding response body" after 2+ min
# EMBED_PROVIDER=ollama
# EMBED_MODEL_ID=nomic-embed-text
# DRAFT_LLM_PROVIDER=ollama         # REQUIRED for `docbrain generate`/autopilot on Ollama: the baked-in
# DRAFT_MODEL_ID=command-r:35b      # draft-model default targets Bedrock and 404s against Ollama otherwise
# OLLAMA_TLS_VERIFY=false          # Set to true to enforce TLS certificate validation
# OLLAMA_VISION_ENABLED=true       # Set to false if your Ollama model does not support vision

# ── Document Sources ──────────────────────────────────────────────────────
# Ingestion sources live under the `sources:` umbrella in config YAML. Each
# provider has one config block with optional sub-sources (code, pull_requests,
# merge_requests, threads). A sub-source runs when its block is present in
# YAML. Resource lists (repos, projects, channels, teams, …) must always be
# non-empty — there is no "ingest everything the token can see" fallback.
#
# Scalar secrets (tokens, credentials) can come from env vars below. Resource
# lists must live in config/local.yaml (gitignored) since env vars can only
# carry single values. See docs/configuration.md for the full shape.
#
# Local filesystem — one path, no credentials
LOCAL_DOCS_PATH=/data/docs

# Confluence (flat shape, legacy — not nested under `sources:`)
# CONFLUENCE_BASE_URL=https://your-domain.atlassian.net/wiki
# CONFLUENCE_USER_EMAIL=
# CONFLUENCE_API_TOKEN=
# CONFLUENCE_SPACE_KEYS=DOCS,ENG
# CONFLUENCE_API_VERSION=v2          # v2 for Cloud (default), v1 for self-hosted Data Center 7.x+
# CONFLUENCE_PAGE_LIMIT=0            # Max pages to ingest per space (0 = unlimited, default)
# CONFLUENCE_TLS_VERIFY=true         # Set to false if using self-signed or internal CA certs

# GitHub — sources.github.*
# GITHUB_TOKEN=                       # repo:read scope, powers sources.github.code and sources.github.pull_requests
# GITHUB_API_URL=                     # Override for GitHub Enterprise (default: https://api.github.com)

# GitLab — sources.gitlab.*
# GITLAB_TOKEN=                       # api scope, powers sources.gitlab.merge_requests
# GITLAB_BASE_URL=                    # Override for self-hosted (default: https://gitlab.com)
# GITLAB_TLS_VERIFY=true              # Set to false for self-signed certs

# Slack ingest — sources.slack.*
# SLACK_INGEST_TOKEN=xoxb-...         # Bot token with channels:history, channels:read, users:read (SEPARATE from SLACK_BOT_TOKEN)

# Jira — sources.jira.*
# JIRA_BASE_URL=https://acme.atlassian.net
# JIRA_USER_EMAIL=
# JIRA_API_TOKEN=

# Linear — sources.linear.*
# LINEAR_API_KEY=

# PagerDuty — sources.pagerduty.*
# PAGERDUTY_API_TOKEN=

# OpsGenie — sources.opsgenie.*
# OPSGENIE_API_KEY=

# Rootly — on-call shim (rootly.get_oncall / list_overrides), read-only
# ROOTLY_API_TOKEN=
# ROOTLY_BASE_URL=https://api.rootly.com   # override only for self-hosted Rootly

# Zendesk — sources.zendesk.*
# ZENDESK_SUBDOMAIN=                  # acme (before .zendesk.com)
# ZENDESK_EMAIL=
# ZENDESK_API_TOKEN=

# Intercom — sources.intercom.*
# INTERCOM_ACCESS_TOKEN=

# Microsoft Teams — sources.ms_teams.*
# MS_TEAMS_TENANT_ID=
# MS_TEAMS_CLIENT_ID=
# MS_TEAMS_CLIENT_SECRET=

# ── Embedding Model Switch ──────────────────────────────────────────────
# When switching embedding providers/models (e.g. Bedrock→Ollama), the vector
# dimensions may change. The server will refuse to start if dimensions don't match.
# Set FORCE_REINDEX=true ONE TIME to delete and recreate the OpenSearch indexes,
# then run ingest to re-embed all documents. Remove/unset after the migration.
# FORCE_REINDEX=true

# ── Optional Features ────────────────────────────────────────────────────
# LLM_THINKING_BUDGET=10000          # Extended thinking token budget (0 = disabled)
# HAIKU_MODEL_ID=                    # Override the fast/cheap model used for image descriptions

# ── Image Extraction ─────────────────────────────────────────────────────
# Extracts and describes images from Confluence pages using vision LLM.
# IMAGE_EXTRACTION_ENABLED=true      # Set to false to disable image extraction entirely
# IMAGE_MAX_PER_PAGE=20              # Max images to process per Confluence page
# IMAGE_MIN_SIZE_BYTES=5120          # Skip images smaller than this (bytes, default: 5KB)
# IMAGE_MAX_SIZE_BYTES=10485760      # Skip images larger than this (bytes, default: 10MB)
# IMAGE_DOWNLOAD_TIMEOUT=30          # HTTP download timeout in seconds
# IMAGE_LLM_TIMEOUT=120              # LLM vision call timeout in seconds

# ── Slack Integration ────────────────────────────────────────────────────
# Required OAuth scopes for the Slack bot token:
#   channels:history     — read channel message history (needed for thread capture)
#   channels:read        — list channels
#   chat:write           — post answers and capture confirmations
#   commands             — receive /docbrain slash commands
#   users:read           — resolve user display names in threads, and decide member or guest
#                          (required: without it every asker is treated as a guest)
#   app_mentions:read    — receive @DocBrain capture mentions in threads
#   users:read.email     — look up doc authors by email for stale-doc DMs
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_SIGNING_SECRET=

# Channel to post critical gap alerts after each analysis run (e.g. #docs-alerts).
# Only fires when new critical-severity gaps are found. Requires SLACK_BOT_TOKEN.
# SLACK_GAP_NOTIFICATION_CHANNEL=#docs-alerts

# Stale doc notifications — sends DMs to doc owners (requires Slack)
# NOTIFICATION_INTERVAL_HOURS=24
# NOTIFICATION_SPACE_FILTER=PLATFORM,SRE  # optional: limit to specific spaces

# ── GitHub Real-Time Capture ─────────────────────────────────────────────
# Enables `@docbrain capture` on any GitHub PR or issue comment.
# When a comment contains "@docbrain capture", DocBrain fetches the full thread
# and generates an Autopilot draft immediately.
#
# Setup (one-time, per repo):
#   GitHub repo → Settings → Webhooks → Add webhook
#     Payload URL:  https://your-docbrain-host/github/events
#     Content type: application/json
#     Secret:       <same value as GITHUB_WEBHOOK_SECRET below>
#     Events:       Issue comments, Pull request review comments
#
# Required token scopes: repo (read) + write:discussion
# GITHUB_WEBHOOK_SECRET=           # HMAC secret — must match the webhook secret above
# GITHUB_BOT_TOKEN=ghp_...         # Token to post capture confirmation replies

# ── GitLab Real-Time Capture ─────────────────────────────────────────────
# Full setup in docs/gitlab-capture.md.
# GITLAB_BOT_USER_ID=              # Numeric GitLab user id of the account behind GITLAB_CAPTURE_TOKEN;
#                                  # notes by that account never trigger an ask reply (loop guard)

# ── Documentation Autopilot (gap analysis + draft generation) ────────────
# NOTE: `docbrain generate` shares this drafting subsystem — it returns
# 503 "generation is not configured" until AUTOPILOT_ENABLED=true.
# AUTOPILOT_ENABLED=false
# AUTOPILOT_GAP_ANALYSIS_INTERVAL_HOURS=6   # How often the background scheduler runs
# AUTOPILOT_LOOKBACK_DAYS=30                # Days of query history to analyse for gaps
# AUTOPILOT_CLUSTER_THRESHOLD=0.82          # Cosine similarity for clustering (0.65=loose, 0.85=strict)
# AUTOPILOT_MIN_CLUSTER_SIZE=3              # Min episodes in a cluster to consider it a gap
# AUTOPILOT_MIN_UNIQUE_USERS=2              # Min distinct users that must hit the same gap
# AUTOPILOT_MIN_NEGATIVE_RATIO=0.15         # Min fraction of queries on a topic that must be negative
# AUTOPILOT_MAX_CLUSTERS=50                 # Max gap clusters to persist per analysis run
# AUTOPILOT_MAX_EPISODES=500                # Max negative episodes to load per run
# AUTOPILOT_TARGET_MIN_SCORE=45.0           # Corpus-probe relevance floor: min hybrid probe score a target doc must reach before autopilot auto-picks it to augment a poor-coverage gap; below this -> needs human pick
# AUTOPILOT_ANSWER_TOPICS_ENABLED=false    # Group answers into topics for capture authors (off until topics pass the quality bar)
# GENERATED_DOCS_RETENTION_DAYS=90          # Retention (days) for persisted `generate` runs shown in the web /generate History view; rows older are purged daily and the list/detail filter to this window. Owner-scoped body; set 0 to keep indefinitely
# DOCBRAIN_GENERATE_SOURCE_STALENESS_WARN_DAYS=365
                                     # Staleness warn window (days) for a
                                     # generation's grounding sources. Older
                                     # DocBrain-ingest date -> STALE in the trust
                                     # headline; within -> FRESH; unknown date ->
                                     # UNKNOWN (distinct from fresh, never assumed).
# DOCBRAIN_GENERATE_MAX_SECTION_ASKS=8      # Max per-section retrievals a `generate` run fires. The doc is decomposed into sections and the same retrieval engine `/ask` uses is driven once per section to gather grounded content; a section is filled only when that retrieval returns high-tier, on-topic evidence, else NEEDS INPUT. Sections past the cap are reported not-asked. Clamped 0..=24; 0 disables per-section retrieval (single corpus gather)

# ── Freshness Scoring ─────────────────────────────────────────────────────
# FRESHNESS_SCHEDULER_INTERVAL_HOURS=24     # How often freshness scores are recalculated
# CONTRADICTION_CHECKS_PER_PASS=10          # Max docs checked for contradictions per run (LLM cost)
# CONTRADICTION_INCLUDE_RECENT_EVENT_DOCS=true   # Include recent Slack/PR/Jira docs in contradiction pass
# CONTRADICTION_EVENT_DOC_MAX_AGE_DAYS=90        # Only event-based docs within N days are eligible

# ── Semantic Quality Scoring ─────────────────────────────────────────────
# SEMANTIC_QUALITY_ENABLED=true           # Enable LLM-based semantic quality scoring
# SEMANTIC_QUALITY_INTERVAL_HOURS=24      # How often the semantic sweep runs
# SEMANTIC_QUALITY_BUDGET=50              # Max documents scored per sweep (LLM cost control)
# SEMANTIC_QUALITY_STRUCTURAL_THRESHOLD=40.0  # Min structural score to be eligible for semantic scoring

# ── Memory Consolidation ──────────────────────────────────────────────────
# CONSOLIDATION_INTERVAL_HOURS=6            # How often the memory consolidation job runs

# ── Learning Pipeline (Tier 2 — disabled by default) ─────────────────────
# Uncomment the trainer block in docker-compose.yml first, then set these.
# See docs/learning.md for full setup.
# LEARNING_ENABLED=true
# EMBED_PROVIDER=local                      # Use the fine-tuned local model
# TRAINER_API_KEY=                          # Shared secret — generate: openssl rand -hex 32

# ── Data Retention ────────────────────────────────────────────────────────
# EPISODE_RETENTION_DAYS=90                 # Episode (query history) retention. Set to 0 to disable.
# AUDIT_RETENTION_DAYS=365                  # Audit log retention. Set to 0 to disable.

# ── RAG Pipeline ──────────────────────────────────────────────────────────
RAG_CLAIM_VERIFICATION=true                 # Verify file paths an answer cites against the listings
                                            # recorded at ingest. Deterministic, no LLM call. Inert
                                            # until a git source records a listing.
# ASK_WALL_CLOCK_SECS=600                   # Hard cap on a whole /ask, in seconds. Every
#                                           # stage inside has its own budget and none bounds
#                                           # the sum — a measured question ran 1077s with
#                                           # every stage inside its limit. Generous on
#                                           # purpose (slowest honest answer measured: 248s).
#                                           # A cut-off request returns 504 with an
#                                           # explanation, never a partial answer. 0 disables.
# RAG_TOP_K=10                              # Chunks retrieved per query (raise if answers miss context, lower to reduce token cost)
# RAG_BM25_BOOST=1.0                        # BM25 keyword weight vs vector search (raise to 2-3 for error codes / CLI commands)

# ── Five-stage retrieval pipeline (opt-in via RAG_RERANK_PROVIDER) ────
# Default is "none" → legacy single-hybrid-search path runs unchanged.
# Set to "bedrock" (or another enabled provider) to activate:
#   - candidate generation with RRF fusion over multiple retrievers
#   - cross-encoder semantic reranking
#   - diversity + coverage constraints on the final top-k
#   - confidence floor before the LLM sees noise
# Rollback = flip this back to "none". No rebuild, no migration.
# RAG_RERANK_PROVIDER=none                    # none | bedrock | cohere | voyage | jina | ollama
# RAG_RERANK_MODEL_ID=                        # provider-specific default if unset
# RAG_RERANK_TOP_N=200                        # candidates scored per query
# RAG_RERANK_BATCH_SIZE=100                   # docs per reranker API call
# RAG_RERANK_TIMEOUT_SECS=10                  # per-call timeout (hot-path, keep tight)
# COHERE_RERANK_API_KEY=                      # required when provider=cohere
# VOYAGE_API_KEY=                             # required when provider=voyage
# JINA_API_KEY=                               # required when provider=jina
# RAG_RERANK_OLLAMA_BASE_URL=                 # defaults to llm.ollama_base_url

# Pipeline knobs — every value configurable, zero hardcoding:
# RAG_CANDIDATE_POOL_SIZE=200                 # pool size fed to reranker
# RAG_RRF_K=60                                # RRF damping constant (canonical paper)
# RAG_MAX_PER_SOURCE=3                        # per-source cap in final top-k
# RAG_MAX_PER_DOCUMENT=2                      # per-document cap in final top-k
# RAG_MIN_RELEVANCE_SCORE=0.30                # retrieval floor — drop below this from diversity
# RAG_DISPLAY_FLOOR=0.30                      # display floor — drop below this from sources array
# RAG_CONFIDENCE_GATE=0.30                    # confidence gate — hide all sources below this confidence
# RAG_STRONG_ANSWER_FLOOR=0.50                # high-confidence answer threshold
# RAG_FRESHNESS_WINDOW_DAYS=7                 # freshness retriever window (0 to disable)
# RAG_FRESHNESS_PRE_DIVERSITY: deprecated. The legacy path multiplied rerank
# scores by a freshness multiplier before the retrieval floor, which let old
# but relevant docs fall below the floor even when they were the top match.
# Freshness is now display metadata only. Set to `true` to opt back into the
# deprecated behaviour; not recommended.
# RAG_ENTITY_CACHE_TTL_SECS=300               # entity → space cache TTL
# RAG_MAX_REWRITES=2                          # query rewrites per ask (0 to disable)
# RAG_MAX_CHUNKS_PER_DOC=2                    # Phase 2 chunk-flood fix — per-retriever cap
# RAG_RERANK_TITLE_ENRICH=true                # pass title+heading+space to reranker (recommended)
# RAG_COMPOUND_DECOMPOSE=true                 # Phase 5 — split compound questions into sub-intents

# ── Feedback → source-suppression learning loop ──────────────────────────
# When a user marks a SPECIFIC source not-relevant (per-source thumbs-down),
# down-rank that document in retrieval for SIMILAR future questions. Scope =
# the episodes already recalled on the hot path. Threshold-gated so one click
# can't unilaterally bury a doc; suppressed when it crosses EITHER gate. Set
# both min_* to 0 to disable suppression entirely.
# RAG_SUPPRESSION_MIN_FEEDBACK_COUNT=2            # Total not-relevant events before suppress.
# RAG_SUPPRESSION_MIN_UNIQUE_USERS=2              # Distinct users before suppress.
# RAG_SUPPRESSION_RAG_PENALTY_FACTOR=0.1          # Score multiplier (0,1]; smaller = stronger.

# ── Regenerate-with-feedback loop ─────────────────────────────────────────
# Consumes the doc reviewer's flags and regenerates a draft until they clear.
# The UI is human-in-loop (each "Regenerate" click = one round, capped at
# max_revisions); the CLI/generate path auto-reviews (capped at max_rounds).
# Reviewer feedback shapes the writing prompt only — it can never clear a
# flagged claim (the reviewer re-derives flags from the evidence). The round
# cap is the hard backstop: the loop never runs forever, never silently ships
# flags. Unset → defaults; set-but-invalid → warn + default.
# DOCBRAIN_REGEN_LOOP_ENABLED=true                # Master kill-switch (disable with false/0/no/off).
# DOCBRAIN_REGEN_LOOP_MAX_ROUNDS=3                # CLI/generate auto-review cap (1..=20).
# DOCBRAIN_REGEN_LOOP_MAX_REVISIONS=10           # UI human-in-loop cap per draft (1..=100).
# DOCBRAIN_REGEN_LOOP_MIN_BUDGET_MS=20000        # Min wall-clock headroom to start a round; 0 disables.

# ── Hollow-document guard (generation) ────────────────────────────────────
# Refuses (HTTP 422) a draft ONLY when it has no inline seed, no High-tier
# authoritative grounding, AND no Low-tier live-tool grounding either, AND is
# mostly unanswered "NEEDS INPUT:" placeholders (>= ratio_pct of its `##`
# sections). A no-seed/no-High draft that DOES have live/Low grounding ships
# UNVERIFIED (barred from auto-publish) instead of refusing. Applies to SHORT
# docs too now (the old min-sections floor was removed; only floor left is
# section_count > 0).
# DOCBRAIN_GENERATE_HOLLOW_RATIO_PCT=50          # Refuse when >= this % of sections are NEEDS-INPUT.

# ── Support Critic (grounding) ────────────────────────────────────────────────
# The doc-generation GROUNDING reviewer: extracts the draft's claims and flags the
# ones NO supplied source supports (fabrication), plus `NEEDS INPUT:` markers the
# sources actually cover (inverted self-flag). ADVISORY — never blocks; surfaced in
# the grounding report. ON by default; fail-OPEN (ships the draft unchanged on error).
# DOCBRAIN_SUPPORT_CRITIC_ENABLED=true           # Master kill-switch (disable only with false/0/no/off).
# DOCBRAIN_SUPPORT_CRITIC_MAX_CLAIMS=40          # Hard cap on claims grounding-checked per draft (range 1..=200).
# DOCBRAIN_SUPPORT_CRITIC_NOFAB_ENFORCE=true   # NoFab: degrade ungrounded FRESH sections to NEEDS INPUT in place so fabrication can't reach the reader (default ON; disable only with false/0/no/off).

# ── Merged-doc update ──
# When generating against an existing target doc, return the FULL merged document —
# unchanged sections preserved byte-exact, changed sections rewritten, additions
# surfaced — plus a per-section change manifest, so the output can replace the whole
# doc with confidence about what changed. Kill-switch defaults ON.
# DOCBRAIN_MERGE_ENABLED=true                     # Master kill-switch (disable only with false/0/no/off).
# DOCBRAIN_MERGE_MAX_SECTIONS=60                  # Max existing sections fed to the merge pass (range 1..=500).
# DOCBRAIN_MERGE_MAX_TOKENS=4096                  # Max output tokens for the merge decision (range 512..=32768).

# ── Agentic tool loop (subsumes confidence-retry above when enabled) ──────
# Generalizes the one-shot confidence-retry into a bounded MULTI-round tool
# loop: after each round of tool results, stop-or-continue is decided per
# surface (Slack vs web/api). When RAG_AGENTIC_LOOP_ENABLED=true this loop
# SUBSUMES the confidence-retry — the loop runs instead of the single retry.
# Default OFF — opt-in per deployment. Unset → silent default; set-but-
# invalid → warn + default.
# RAG_AGENTIC_LOOP_ENABLED=false                  # Master switch. true|1|yes|on enables.
# RAG_AGENTIC_LOOP_MAX_ROUNDS_SLACK=5             # Max tool-dispatch rounds, Slack surface.
                                                  # Bounded 1–10; out-of-range → default.
# RAG_AGENTIC_LOOP_MAX_ROUNDS_WEB=4               # Max rounds, web/api (synchronous HTTP).
                                                  # Bounded 1–10; out-of-range → default.
# RAG_AGENTIC_LOOP_BUDGET_MS_SLACK=60000          # Wall-clock deadline (ms), Slack surface.
                                                  # Bounded 1000–120000; out-of-range → default.
# RAG_AGENTIC_LOOP_BUDGET_MS_WEB=30000            # Wall-clock deadline (ms), web/api surface.
                                                  # Bounded 1000–120000; out-of-range → default.
# RAG_AGENTIC_LOOP_CONFIDENCE_THRESHOLD=0.7       # Stop-when-confident bar; loop continues
                                                  # while best confidence is below this.
                                                  # Bounded 0.0–1.0. Unset → falls back to
                                                  # RAG_CONFIDENCE_RETRY_THRESHOLD, then 0.7.

# ── Tool-output caps (the truncation chain) ───────────────────────────────
# Three coordinated caps bound how much raw tool output reaches the synthesis
# prompt. They MUST rise together — raising one alone has no effect because the
# smallest in the chain still truncates. Defaults let a high-volume search
# (43-63KB raw) keep ~32KB instead of being truncated. Unset → built-in
# default; set-but-invalid (non-numeric / ≤0) → default.
# DOCBRAIN_MCP_OUTPUT_CEILING_BYTES=32768          # Hard ceiling the manifest validator enforces on any per-tool cap
# DOCBRAIN_MCP_DEFAULT_TOOL_OUTPUT_CAP_BYTES=32768 # Cap inherited by dynamically-discovered tools (must be ≤ ceiling)
# DOCBRAIN_EVIDENCE_BUFFER_CAP_BYTES=65536         # SHARED per-loop-round evidence budget (2x the per-tool cap)
# DOCBRAIN_MCP_JQL_RECENCY_BOUND_DAYS=180          # Recency window appended to unbounded full-text issue-tracker searches (avoids timeouts)

# ── Live-tool fan-out caps (always-on tool dispatch) ──────────────────────
# Bound the always-on full-catalog fan-out the orchestrator runs after retrieval.
# Max concurrent gateway dispatches per fan-out pass (clamped 1..=64). Caps
# in-flight tool calls so an always-on full-catalog fan-out can't spawn-storm.
# MCP_TOOLS_FANOUT_MAX_CONCURRENT=8
# Max TOTAL chars of live-tool evidence admitted into one generate fan-out
# (clamped 1000..=200000). Bounds per-tool live evidence so a verbose catalog
# can't stuff the writing prompt; whole lowest-priority chunks past the budget
# are dropped at chunk boundaries (never truncated mid-chunk).
# MCP_TOOLS_FANOUT_MAX_ADMITTED_CHARS=24000
# Per-connector cooldown TTL in seconds (0 disables, clamped 0..=600). On a
# 429 / timeout / transient failure a connector is skipped for this TTL across
# requests so the always-on fan-out can't re-hammer a flaky connector. Keyed on
# the connector's OWN recent failures; cleared the moment it succeeds.
# MCP_TOOLS_FANOUT_COOLDOWN_SECS=30
# RAG_TRACE_DETAIL=false                      # log per-chunk rerank output in final top-k
# SEARCH_MIN_SCORE=0.0                      # Drop chunks below this score (0.3-0.4 filters noise; 0.0 keeps all)
# RAG_CACHE_TTL_HOURS=24                    # How long a cached answer is served to the exact same question; 0 = off

# ── Premises (living claims) ──────────────────────────────────────────────
# PREMISE_MONITOR_ENABLED=true       # Standing monitor that re-checks file-path premises against the connected sources' listings
# PREMISE_SWEEP_INTERVAL_SECS=300    # Seconds between sweeps; a sweep reads premises in pages of 1,000. Values below 5 are raised to 5
# PREMISE_DOCUMENT_EXTRACTION=false  # Also extract premises from ingested documents, not only captures. Turning it on runs a one-time
                                     # pass over the whole corpus; docs/premises.md gives the cost

# ── OpenSearch Index Names ────────────────────────────────────────────────
# Only needed if you run multiple DocBrain instances sharing the same OpenSearch cluster.
# OPENSEARCH_INDEX=docbrain-chunks
# OPENSEARCH_EPISODE_INDEX=docbrain-episodes

# ── Images and the ingest schedule (docker compose) ───────────────────────
# DOCBRAIN_IMAGE=ghcr.io/docbrain-ai/docbrain:latest          # the server, keys and ingest services
# DOCBRAIN_WEB_IMAGE=ghcr.io/docbrain-ai/docbrain-web:latest  # the web service
# DOCBRAIN_PULL_POLICY=always                                 # `never` to run an image built on this machine
# DOCBRAIN_PLATFORM=linux/amd64                               # `linux/arm64` for an arm64 build
# INGEST_INTERVAL_SECS=3600                                   # the ingest service runs at start, then every N seconds; 0 = once

# ── Reverse proxy (single origin) ─────────────────────────────────────────
# docker-compose serves the web UI and the API through ONE origin (a Caddy
# proxy: /api/* → server, /* → web). This is required because the web image's
# baked-in CSP is `connect-src 'self'` — a two-origin setup blocks login.
# PROXY_PORT is the ONLY port published to the host; open it in the browser.
# PROXY_PORT=3001                    # host port for the whole app (UI + /api/*)
# PROXY_ORIGIN=http://localhost:3001 # the public origin; drives CORS + links
# PROXY_LISTEN=3001                  # in-container Caddy bind (match container side of PROXY_PORT)

# ── Server ────────────────────────────────────────────────────────────────
# NOTE: SERVER_PORT is an INTERNAL container port only — it is NOT published to
# the host (the proxy is the single front door). A CLI or external client should
# target PROXY_ORIGIN (e.g. http://localhost:3001), whose /api/* is forwarded to
# the server. To expose the API directly, re-add a `ports:` mapping to the
# server service in docker-compose.yml.
# SERVER_PORT=3000                   # internal only (proxied at PROXY_ORIGIN/api/*)
# MAX_QUERY_LENGTH=4000              # Max chars for question/description inputs

# ── Web UI / CORS ─────────────────────────────────────────────────────────
# Defaults to PROXY_ORIGIN. Set to your public web origin in production
# (e.g. https://docbrain.yourco.com). Must equal the origin the browser uses.
# CORS_ALLOWED_ORIGINS=http://localhost:3001

# ── Auth / Sessions ───────────────────────────────────────────────────────
# LOGIN_SESSION_TTL_HOURS=720        # Session lifetime (default: 720h = 30 days, 0 = no expiry)

# ── Event Bus ──────────────────────────────────────────────────────────────
# Internal pub/sub for all significant system actions. Always enabled.
# EVENT_BUS_CAPACITY=4096              # Broadcast channel buffer size (max: 65536)
# EVENT_LOG_RETENTION_DAYS=90          # Days to retain events in event_log table

# ── Knowledge Fragments ──────────────────────────────────────────────────
# FRAGMENT_REVIEW_THRESHOLD=0.4      # Summary floor: a DocBrain summary below this model confidence is not stored (default: 0.4)
# FRAGMENT_MAX_CONTENT_LENGTH=10000   # Max fragment content length in characters (default: 10000)
# FRAGMENT_MAX_PER_AUTHOR_PER_HOUR=60 # Captures one author may write per rolling hour; 429 above (default: 60)
# CAPTURE_SECRET_CHECK_TIMEOUT_SECS=10      # Model secret check budget per capture, seconds (default: 10)
# CAPTURE_SECRET_CHECK_MAX_REPLY_TOKENS=4096 # Model secret check reply cap (default: 4096)

# ── Self-Ingest ────────────────────────────────────────────────────────────
# Auto-ingest DocBrain's own docs so it can answer configuration questions about itself.
# DOCBRAIN_SELF_INGEST=false
# DOCBRAIN_DOCS_PATH=./docs

# ── SSO / OIDC (Enterprise) ───────────────────────────────────────────────
# OIDC_ISSUER_URL=                   # e.g. https://accounts.google.com
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# Callback goes through the proxy front door (/api/* is forwarded to the server),
# so use PROXY_ORIGIN, NOT the internal server port.
# OIDC_REDIRECT_URI=http://localhost:3001/api/v1/auth/oidc/callback

# ── Web UI base URL ──
# Public origin of the DocBrain WEB UI. Drives the MCP-OAuth landing redirect AND the
# "view in browser" link the CLI prints after a generate (+ the shareable per-doc
# link). Set to the user-facing web origin — NOT the API host if they differ. Unset →
# no link offered (never guessed/hardcoded). Trailing slash trimmed.
# DOCBRAIN_WEB_BASE_URL=http://localhost:3001

# ── Sign-in for apps (OAuth for the MCP endpoint) ──
# On with Docker Compose: apps such as Claude Code connect to <DOCBRAIN_WEB_BASE_URL>/api/v1/mcp by
# signing in and being allowed, instead of a pasted key. Needs DOCBRAIN_WEB_BASE_URL: https, or
# http://localhost for development. off turns it off.
# DOCBRAIN_OAUTH_SERVER=on
# Optional: fetch app documents through this proxy (it then guards which addresses are reached).
# DOCBRAIN_OAUTH_DOCUMENT_PROXY=
# Proxies of yours in front of the server, for the per-address sign-in limits. Compose sets 1 (its
# proxy). A load balancer in front of that proxy: trust it in config/Caddyfile
# (servers { trusted_proxies static <its range> }), then set 2.
# TRUSTED_PROXY_HOPS=1

# Prompt budgets (bytes). The real limit is the model's TOKEN window, and
# providers truncate an over-long prompt silently rather than erroring.
# RAG_LIVE_DATA_BUDGET_BYTES is an AGGREGATE bound over every tool block
# concatenated into one prompt; each tool's own output is capped separately
# by DOCBRAIN_MCP_DEFAULT_TOOL_OUTPUT_CAP_BYTES, so this is what bounds
# several tools answering at once. Measured 2026-09-04: a tool returning
# 103,479 bytes reached the prompt as 8,475 after capping and redaction.
# RAG_CONTEXT_WINDOW_BUDGET_BYTES=65536   # expanded document context
# RAG_LIVE_DATA_BUDGET_BYTES=32768        # all tool blocks combined

# Retrieval ladder. Default OFF. Synthesizes an indexed-only answer AND a
# live-tool answer, then an LLM judge keeps the better one — so live tool
# output can only help, never degrade, an answer the corpus already had.
# Measured: a question answered at 0.90 from the corpus alone fell to 0.15
# once a tool returned results into the same prompt. Extra cost applies only
# when a tool fires; the two syntheses run concurrently. On judge timeout the
# higher self-graded confidence wins. The 1500ms default was unreachable for a
# local model (a 14B judge call measured 46-120s), hence 10000.
# RAG_RETRIEVAL_LADDER_ENABLED=false
# RAG_RETRIEVAL_LADDER_JUDGE_TIMEOUT_MS=10000

# >>> generated: every other setting — do not edit; run scripts/check-config-surfaces.py --write >>>
# ── Config File Location ──
# Directory containing YAML config files.
# DOCBRAIN_CONFIG_DIR=config
# Selects {APP_ENV}.yaml.
# APP_ENV=development

# ── Infrastructure ──
# Path to a file holding the key (what Compose's generated key uses).
# DOCBRAIN_FINGERPRINT_KEY_FILE=
# Maximum connections in each PostgreSQL pool the server opens.
# DB_MAX_CONNECTIONS=25
# Seconds the server waits to open its database connections at start before giving up.
# DB_CONNECT_TIMEOUT_SECS=10
# Seconds a request waits for a free pooled connection before it fails.
# DB_ACQUIRE_TIMEOUT_SECS=10
# Seconds an unused pooled connection is kept before it is closed.
# DB_IDLE_TIMEOUT_SECS=300

# ── LLM Provider ──
# HTTP timeout in seconds for the LLM client (default: 120).
# LLM_TIMEOUT_SECS=
# Model used during ingest only for image extraction.
# INGEST_LLM_MODEL_ID=
# Base URL of an OpenAI-compatible endpoint to use in place of OpenAI's own, for a proxy such as LiteLLM, vLLM or LocalAI.
# OPENAI_BASE_URL=
# Your Groq API key.
# GROQ_API_KEY=
# Your OpenRouter API key.
# OPENROUTER_API_KEY=
# Your Together AI API key.
# TOGETHER_API_KEY=
# Your DeepSeek API key.
# DEEPSEEK_API_KEY=
# Your Mistral API key.
# MISTRAL_API_KEY=
# Your xAI API key.
# XAI_API_KEY=
# Your Google Gemini API key.
# GEMINI_API_KEY=
# How hard Anthropic models on Bedrock reason: low, medium, high, xhigh or max.
# DOCBRAIN_LLM_EFFORT=

# ── Azure OpenAI ──
# Azure OpenAI API key
# AZURE_OPENAI_API_KEY=
# Resource endpoint. e.g. https://my-resource.openai.azure.com
# AZURE_OPENAI_ENDPOINT=
# API version.
# AZURE_OPENAI_API_VERSION=

# ── Cohere ──
# Cohere API key
# COHERE_API_KEY=

# ── Vertex AI ──
# GCP project ID (e.g. my-project-123)
# VERTEX_PROJECT=
# GCP region.
# VERTEX_REGION=

# ── Embedding provider tuning ──
# Bedrock: concurrent embedding requests the adaptive limiter starts at.
# BEDROCK_INITIAL_CONCURRENCY=2
# Bedrock: the most concurrent embedding requests the limiter will allow.
# BEDROCK_MAX_CONCURRENCY=16
# Ollama: how many times one embedding call is tried before it fails, with a growing pause between tries (capped at 10 seconds).
# OLLAMA_EMBED_MAX_RETRIES=5

# ── Learning pipeline ──
# Base URL of the docbrain-trainer inference sidecar.
# EMBED_LOCAL_INFERENCE_URL=
# Azure storage account for model storage.
# LEARNING_AZURE_ACCOUNT=
# Fewest distinct identified users whose feedback a training run needs.
# LEARNING_MIN_FEEDBACK_USERS=3
# Where trained model files are kept: local, s3, gcs or azure.
# LEARNING_STORAGE_BACKEND=local
# Directory for model files when the backend is local.
# LEARNING_LOCAL_PATH=/app/models
# S3 bucket for model files.
# LEARNING_S3_BUCKET=
# Key prefix inside the S3 bucket.
# LEARNING_S3_PREFIX=docbrain/models
# AWS region of the S3 bucket.
# LEARNING_S3_REGION=us-east-1
# Google Cloud Storage bucket for model files.
# LEARNING_GCS_BUCKET=
# Object prefix inside the GCS bucket.
# LEARNING_GCS_PREFIX=docbrain/models
# Azure Blob container for model files.
# LEARNING_AZURE_CONTAINER=
# Base URL of the docbrain-trainer sidecar the pipeline sends training work to.
# LEARNING_TRAINER_URL=http://docbrain-trainer:8080
# Hugging Face model that fine-tuning starts from.
# LEARNING_BASE_MODEL_ID=sentence-transformers/all-MiniLM-L6-v2
# Fewest training triplets (a query, a right passage and a wrong one) a run needs.
# LEARNING_MIN_TRIPLETS=200
# How far, as a fraction, a new model may lower average answer confidence before it is rolled back. 0.05 is 5 percent.
# LEARNING_CIRCUIT_BREAKER_THRESHOLD=0.05
# Reject a training run whose feedback looks like it came from bots or one person. false skips the check.
# LEARNING_POISON_DETECTION=true
# Largest share of a run's feedback one user may supply before the poison check rejects the run.
# LEARNING_MAX_SINGLE_USER_FRACTION=0.80

# ── Local Files ──
# Set true when the path holds several repositories, one per top-level directory, rather than one tree.
# LOCAL_ROOT_HOLDS_REPOSITORIES=false

# ── Confluence ──
# Comma-separated page IDs to ingest, including all descendants.
# CONFLUENCE_PAGE_IDS=
# Comma-separated names of extra Confluence groups whose members hold a licence. confluence-users and confluence-users-<site> are always counted; add a group here
# CONFLUENCE_LICENSED_GROUPS=
# Shared secret that signs Confluence webhook calls to /confluence/events.
# CONFLUENCE_WEBHOOK_SECRET=

# ── Confluence background syncs ──
# Seconds between runs of the job that resolves Confluence account ids on documents to a name and email. 0 turns it off.
# CONFLUENCE_USER_SYNC_INTERVAL_SECS=900
# Account ids resolved per run.
# CONFLUENCE_USER_SYNC_BATCH_SIZE=100
# Days before an account id that was already resolved is looked up again.
# CONFLUENCE_USER_SYNC_REFRESH_AFTER_DAYS=30
# Milliseconds between Confluence calls in that job; 100 holds it to about 10 requests a second.
# CONFLUENCE_USER_SYNC_PER_CALL_DELAY_MS=100
# Seconds between recomputes of who can see each space. 0 leaves it off.
# CONFLUENCE_SPACE_ACCESS_SYNC_INTERVAL_SECS=0

# ── GitHub PR Reviews (INGEST_SOURCES=github_pr) ──
# GitHub personal access token with repo:read (or public_repo) scope
# GITHUB_PR_TOKEN=
# Repository in owner/repo format. e.g. acme/platform
# GITHUB_PR_REPO=
# Minimum total review comments required to index a PR.
# GITHUB_PR_MIN_COMMENTS=1
# Comma-separated label filter.
# GITHUB_PR_LABELS=
# Override for GitHub Enterprise deployments
# GITHUB_PR_API_URL=https://api.github.com

# ── GitHub Capture Webhook Security (INGEST_SOURCES=github_pr + real-time capture) ──
# Comma-separated owner/repo pairs that are allowed to trigger capture.
# GITHUB_CAPTURE_ALLOWED_REPOS=
# Comma-separated GitHub usernames allowed to trigger capture.
# GITHUB_CAPTURE_ALLOWED_USERS=

# ── GitLab MR + Review Notes (INGEST_SOURCES=gitlab_mr) ──
# GitLab personal or project access token with api scope
# GITLAB_MR_TOKEN=
# Base URL for self-hosted GitLab (e.g. https://gitlab.mycompany.com)
# GITLAB_MR_BASE_URL=https://gitlab.com
# Comma-separated project paths or IDs. e.g. acme/platform,acme/backend
# GITLAB_MR_PROJECT_IDS=
# Minimum discussion notes to index an MR.
# GITLAB_MR_MIN_NOTES=1
# Comma-separated label filter.
# GITLAB_MR_LABELS=
# Set to false to skip TLS certificate verification for self-hosted with internal CA
# GITLAB_MR_TLS_VERIFY=true

# ── GitLab MR Capture Webhook ──
# HMAC secret shared with GitLab for webhook signature verification
# GITLAB_CAPTURE_WEBHOOK_SECRET=
# GitLab personal access token with api scope, used to fetch MR notes and post reply comments
# GITLAB_CAPTURE_TOKEN=
# GitLab instance base URL (override for self-hosted)
# GITLAB_CAPTURE_BASE_URL=https://gitlab.com
# Comma-separated GitLab usernames allowed to trigger capture.
# GITLAB_CAPTURE_ALLOWED_USERS=
# Comma-separated project paths allowed to trigger capture.
# GITLAB_CAPTURE_ALLOWED_PROJECTS=
# true, 1 or yes skips TLS certificate checks when calling the capture GitLab instance.
# GITLAB_CAPTURE_TLS_INSECURE=false

# ── Linear (INGEST_SOURCES=linear) ──
# Comma-separated team keys to index (e.g. ENG,OPS).
# LINEAR_TEAMS=
# How many days back to ingest completed/cancelled issues
# LINEAR_LOOKBACK_DAYS=365
# Comma-separated state names to include
# LINEAR_STATES=Done,Cancelled,Duplicate

# ── PagerDuty (INGEST_SOURCES=pagerduty) ──
# Days back to ingest resolved incidents
# PAGERDUTY_LOOKBACK_DAYS=180
# Skip incidents shorter than this many minutes (filters noise/blips)
# PAGERDUTY_MIN_DURATION=5
# Comma-separated PagerDuty service IDs to filter.
# PAGERDUTY_SERVICES=

# ── OpsGenie (INGEST_SOURCES=opsgenie) ──
# Days back to ingest closed alerts
# OPSGENIE_LOOKBACK_DAYS=180
# Skip alerts shorter than this many minutes
# OPSGENIE_MIN_DURATION=5
# Comma-separated team names to filter.
# OPSGENIE_TEAMS=

# ── Zendesk (INGEST_SOURCES=zendesk) ──
# Days back to ingest solved tickets
# ZENDESK_LOOKBACK_DAYS=180
# Satisfaction filter: good, bad, or empty (include all)
# ZENDESK_MIN_RATING=

# ── Intercom (INGEST_SOURCES=intercom) ──
# Days back to ingest conversations
# INTERCOM_LOOKBACK_DAYS=180
# Skip conversations with fewer than this many messages
# INTERCOM_MIN_MESSAGES=2
# Comma-separated tag names to filter.
# INTERCOM_TAGS=

# ── Microsoft Teams (INGEST_SOURCES=ms_teams) ──
# Comma-separated team names or IDs to filter.
# MS_TEAMS_TEAMS=
# How many days back to ingest messages
# MS_TEAMS_LOOKBACK_DAYS=90
# Include 1:1 and group chat messages.
# MS_TEAMS_INCLUDE_CHATS=false
# Include files shared in channels (from SharePoint)
# MS_TEAMS_INCLUDE_FILES=true
# Include meeting transcripts (requires application access policy)
# MS_TEAMS_INCLUDE_TRANSCRIPTS=true
# Minimum replies for a channel message thread to be indexed
# MS_TEAMS_MIN_REPLIES=2
# The clientState value set on the Graph change-notification subscription.
# MS_TEAMS_WEBHOOK_CLIENT_STATE=

# ── Policy file sources (.docbrain/style.md) ──
# Base URL for GitLab when pulling a policy file.
# GITLAB_API_URL=https://gitlab.com
# Base URL for Bitbucket Cloud when pulling a policy file.
# BITBUCKET_API_URL=https://api.bitbucket.org
# Bearer token for Bitbucket policy pulls, used when the source has no token of its own.
# BITBUCKET_TOKEN=
# Days without an edit before a space override counts as stale in the sprawl banner on the quality page.
# STYLE_SPRAWL_STALE_DAYS=90
# Overrides in one space above which the sprawl banner flags that space.
# STYLE_SPRAWL_EXCESS_THRESHOLD=20
# Seconds between pulls of registered policy files. 0 turns the sync off.
# POLICY_FILE_SYNC_INTERVAL_SECS=900

# ── Ingest runs ──
# The code default is false when the ingest: block is absent; the shipped config/default.yaml has the block, so it is true.
# INGEST_PRUNE_DELETED=true
# Run one ingest when the server starts, before the first scheduled run.
# INGEST_RUN_ON_STARTUP=false
# Comma-separated file extensions to skip, without dots (png,zip).
# INGEST_SKIP_EXTENSIONS=
# true or 1 re-embeds every document whatever its stored version.
# FORCE_REINGEST=false
# Path to the docbrain-ingest binary the server starts for an ingest triggered from the console or API.
# DOCBRAIN_INGEST_BIN=
# Confluence pages fetched and processed at once during a Confluence ingest.
# INGEST_CONCURRENCY=10

# ── Connector scheduler ──
# Run the connector scheduler. false stops all connector syncs.
# CONNECTOR_ENABLED=true
# Connector syncs that may run at once.
# CONNECTOR_MAX_CONCURRENT_SYNCS=3
# Most pages one sync fetches.
# CONNECTOR_MAX_PAGES_PER_SYNC=200
# Most documents one sync ingests.
# CONNECTOR_MAX_DOCS_PER_SYNC=5000
# The same limit as CONNECTOR_MAX_DOCS_PER_SYNC, read from the config file.
# CONNECTOR_MAX_DOCUMENTS_PER_SYNC=5000
# Documents asked for in one fetch call to a connector.
# CONNECTOR_FETCH_BATCH_SIZE=50
# Seconds before one HTTP call to a connector times out.
# CONNECTOR_REQUEST_TIMEOUT_SECS=30
# Seconds one whole sync may run (the default is one hour).
# CONNECTOR_SYNC_TIMEOUT_SECS=3600
# Largest response body accepted from a connector, in bytes (10 MB).
# CONNECTOR_MAX_RESPONSE_BYTES=10485760
# Failures in a row after which a connector is switched off.
# CONNECTOR_CIRCUIT_BREAKER_THRESHOLD=5
# Let connectors call private or internal addresses.
# CONNECTOR_ALLOW_INTERNAL=false

# ── Chunking ──
# Target chunk size in characters
# CHUNK_SIZE=1500
# Overlap between adjacent paragraph-split chunks
# CHUNK_OVERLAP=200

# ── RAG Pipeline ──
# Below this winning confidence, the answer is augmented with graph-derived related-topics text.
# RAG_RETRIEVAL_LADDER_GRAPH_THRESHOLD=0.5
# Model for the judge call.
# RAG_RETRIEVAL_LADDER_JUDGE_MODEL_ID=
# Neighbouring chunks fetched on each side of a matched chunk, so the answer sees the passage and not only the fragment. 0 turns the expansion off.
# RAG_CONTEXT_WINDOW_CHUNKS=3
# The older name of the loop's confidence threshold, still read when RAG_AGENTIC_LOOP_CONFIDENCE_THRESHOLD is unset, so a cluster that tuned it keeps its value.
# RAG_CONFIDENCE_RETRY_THRESHOLD=0.7
# true always answers from one pass over the indexed documents and every live-tool result together, and never uses the winner-pick ladder.
# RAG_FUSION_PREFER_FUSED=false
# Retired.
# RAG_CACHE_THRESHOLD=

# ── Tool-output caps (the truncation chain) ──
# Master kill-switch for the sufficiency critic — a scope-relative answer-quality gate that runs after synthesis.
# DOCBRAIN_SUFFICIENCY_CRITIC_ENABLED=true
# Hard cap on the number of recovery rounds the critic may force (range 0..=2).
# DOCBRAIN_SUFFICIENCY_CRITIC_MAX_RECOVERY_ROUNDS=1
# Skip the critic entirely when the mechanical confidence is already ≥ this value (a confidently-answered question doesn't need re-judging).
# DOCBRAIN_SUFFICIENCY_CRITIC_SKIP_ABOVE_CONFIDENCE=0.85
# The coverage-fraction dial the critic prompt judges against (the "how complete is complete" threshold on the question's own sub-questions).
# DOCBRAIN_SUFFICIENCY_CRITIC_MIN_COVERAGE=0.9
# Minimum wall-clock headroom (ms) required to allow a critic-forced recovery round.
# DOCBRAIN_SUFFICIENCY_CRITIC_MIN_RECOVERY_BUDGET_MS=20000
# Master kill-switch for the freshness critic — the doc-generation reviewer that runs after a draft is written.
# DOCBRAIN_FRESHNESS_CRITIC_ENABLED=true
# Hard cap on the number of claims validated per draft (across new + existing-doc content).
# DOCBRAIN_FRESHNESS_CRITIC_MAX_CLAIMS=60
# How many claims (with their evidence) go into one batched judgment LLM call.
# DOCBRAIN_FRESHNESS_CRITIC_BATCH_SIZE=12
# How many evidence snippets to retrieve per claim.
# DOCBRAIN_FRESHNESS_CRITIC_EVIDENCE_PER_CLAIM=5
# Minimum wall-clock headroom (ms) required to run the critic at all.
# DOCBRAIN_FRESHNESS_CRITIC_MIN_BUDGET_MS=20000
# Master kill-switch for in-place reconcile.
# DOCBRAIN_RECONCILE_ENABLED=true
# Max sections reconciled in a single draft, bounding the per-draft LLM + splice cost.
# DOCBRAIN_RECONCILE_MAX_SECTIONS=5
# Byte floor below which a search/list tool's ok result is treated as *near-empty* (a 200-but-no-results response, e.g. a "no matches" JSON envelope).
# DOCBRAIN_EMPTY_RESULT_FLOOR_BYTES=256

# ── Hosted provider credentials ──
# MIXEDBREAD_API_KEY=
# pinecone.io — uses Api-Key header, not Bearer
# PINECONE_API_KEY=

# ── Custom provider — plug-and-play for any Cohere-family rerank API ──
# Full POST URL, e.g. https://api.example.test/v1/rerank
# RAG_RERANK_CUSTOM_BASE_URL=
# Name of another env var that holds the API key (the key is never persisted in config.yaml)
# RAG_RERANK_CUSTOM_API_KEY_ENV=
# bearer_token or custom_header
# RAG_RERANK_CUSTOM_AUTH_STYLE=bearer_token
# Header name, e.g. Api-Key
# RAG_RERANK_CUSTOM_AUTH_HEADER_NAME=
# Request JSON key for the documents array
# RAG_RERANK_CUSTOM_DOCUMENTS_FIELD=documents
# Request JSON key for the top-N limit
# RAG_RERANK_CUSTOM_TOP_N_FIELD=top_n
# Response JSON key for the results array
# RAG_RERANK_CUSTOM_RESULTS_FIELD=results
# Response JSON key for the score
# RAG_RERANK_CUSTOM_SCORE_FIELD=relevance_score

# ── Autopilot / Gap Analysis ──
# How many hourly topic runs may fail to embed one question before that question is no longer read, so one question the embedder always rejects cannot hold the
# AUTOPILOT_ANSWER_TOPIC_MAX_EMBED_FAILURES=3
# Automatically generate drafts for qualifying gaps (no human trigger).
# AUTOPILOT_AUTO_DRAFT=false
# Minimum gap severity for auto-drafting: critical, high, medium, or low
# AUTOPILOT_AUTO_DRAFT_SEVERITY=critical
# Unique users needed for breadth score to reach 1.0.
# AUTOPILOT_CRITICAL_USERS=5
# Negative signals needed for volume score to reach 1.0.
# AUTOPILOT_CRITICAL_SIGNALS=15
# Composite score cutoff for "critical" severity.
# AUTOPILOT_CRITICAL_THRESHOLD=0.75
# Composite score cutoff for "high" severity.
# AUTOPILOT_HIGH_THRESHOLD=0.55
# Composite score cutoff for "medium" severity.
# AUTOPILOT_MEDIUM_THRESHOLD=0.35
# Enable the per-section retrieval-query LLM rewrite.
# DOCBRAIN_GENERATE_VERIFY_SECTION_QUERY_LLM=true
# Enable the per-claim live cross-check (the moat core): each grounded claim is re-verified against the live system it came from.
# DOCBRAIN_GENERATE_VERIFY_CROSS_CHECK=true
# Per-document wall-clock budget (seconds) for the live cross-check. 0 is a disable sentinel (same honest path as DOCBRAIN_GENERATE_VERIFY_CROSS_CHECK=false).
# DOCBRAIN_GENERATE_VERIFY_CROSS_CHECK_BUDGET_SECS=120
# top_k for the two independent non-agentic corpus probes (broad hybrid + catalog title) that confirm a *false* gap before a section degrades to NEEDS INPUT.
# DOCBRAIN_GENERATE_VERIFY_BROAD_PROBE_TOP_K=12
# Max send-back rounds for the post-assess review gate that re-aims a stale section back to write.
# DOCBRAIN_GENERATE_VERIFY_REVIEW_MAX_ROUNDS=2
# Days the record of what an autopilot write replaced (what a revert needs) is kept, before the nightly prune deletes it.
# AUTOPILOT_APPLIED_WRITES_RETENTION_DAYS=30
# Most section questions in flight at once across all running generate requests and the nightly autopilot loop.
# DOCBRAIN_GENERATE_MAX_CONCURRENT_SECTION_ASKS=16
# generate refuses to write a draft when fewer than this many supported claims are about the topic asked.
# DOCBRAIN_GENERATE_REFUSE_MIN_ONTOPIC=3
# Use the five-state gap trend (improving, stable, worsening, no gaps open, insufficient signal).
# AUTOPILOT_TREND_V2_ENABLED=true
# Fewest gap events (new plus resolved, over four weeks) before a trend is reported.
# AUTOPILOT_TREND_MIN_EVENTS=5
# Resolved-to-new ratio at or above which the trend reads improving.
# AUTOPILOT_TREND_IMPROVING_THRESHOLD=0.75
# Resolved-to-new ratio below which the trend reads worsening.
# AUTOPILOT_TREND_WORSENING_THRESHOLD=0.40
# Search score above which a gap labelled as a missing document is corrected to poor coverage, because the corpus does have something on it.
# VERIFY_CORPUS_MIN_SCORE=45.0

# ── Improvement evidence ──
# Hours after a fix is published before one whose re-ingest was never confirmed is shown as stale instead of as still in flight.
# IMPROVEMENT_REINGEST_CONFIRM_TIMEOUT_HOURS=72

# ── Draft Publishing — Closing the Feedback Loop ──
# Where to publish drafts: confluence, github, gitlab or none
# DRAFT_PUBLISH_TARGET=none
# Confluence space key (e.g. ENG, SAAS)
# DRAFT_PUBLISH_CONFLUENCE_SPACE_KEY=
# Optional Confluence parent page ID
# DRAFT_PUBLISH_PARENT_PAGE_ID=
# Re-ingest the published page on next ingest cycle
# DRAFT_PUBLISH_AUTO_INGEST=true
# Comma-separated labels added to each pull request a draft opens in the GitHub repository target.
# GITHUB_PUBLISH_PR_LABELS=docbrain,auto-generated
# GitHub API base URL for that target.
# GITHUB_PUBLISH_API_URL=https://api.github.com
# Comma-separated labels added to each merge request a draft opens in the GitLab repository target.
# GITLAB_PUBLISH_MR_LABELS=docbrain,auto-generated
# GitHub token with contents and pull-request write scope, used when a draft is published to a GitHub repository.
# GITHUB_PUBLISH_TOKEN=
# Repository, as owner/repo, that receives published drafts.
# GITHUB_PUBLISH_REPO=
# Branch the pull request is opened against, or committed to when GITHUB_PUBLISH_CREATE_PR is false.
# GITHUB_PUBLISH_BRANCH=main
# Directory in the repository where published drafts are written.
# GITHUB_PUBLISH_DOCS_PATH=docs
# true opens a pull request for each draft. false commits straight to the branch.
# GITHUB_PUBLISH_CREATE_PR=true
# GitLab token with api scope, used when a draft is published to a GitLab repository.
# GITLAB_PUBLISH_TOKEN=
# GitLab base URL for that target.
# GITLAB_PUBLISH_BASE_URL=https://gitlab.com
# Project that receives published drafts, as a numeric id or a namespace/repo path.
# GITLAB_PUBLISH_PROJECT_ID=
# Branch the merge request is opened against, or committed to when GITLAB_PUBLISH_CREATE_MR is false.
# GITLAB_PUBLISH_BRANCH=main
# Directory in the repository where published drafts are written.
# GITLAB_PUBLISH_DOCS_PATH=docs
# true opens a merge request for each draft. false commits straight to the branch.
# GITLAB_PUBLISH_CREATE_MR=true

# ── Freshness Scoring ──
# Documents given the content-currency check (a model call each) per freshness run.
# FRESHNESS_LLM_CALLS_PER_PASS=50
# Documents whose links are checked (an HTTP HEAD each) per freshness run.
# FRESHNESS_LINK_CHECKS_PER_PASS=20
# Add reader engagement (who retrieved and who rated a document) to freshness scoring.
# FRESHNESS_ENGAGEMENT_V2_ENABLED=false
# Fewest distinct people who must have retrieved a document in the window before its engagement counts.
# FRESHNESS_ENGAGEMENT_MIN_RETRIEVERS=3
# Fewest distinct people who must have rated a document in the window before its engagement counts.
# FRESHNESS_ENGAGEMENT_MIN_VOTERS=3
# Days of retrievals and ratings that count.
# FRESHNESS_ENGAGEMENT_WINDOW_DAYS=180

# ── Conversation distillation, fragment clustering and CI capture ──
# Distil captured Slack threads and pull-request discussions into fragments after a capture.
# DISTILLATION_ENABLED=true
# Most distillation model calls at once.
# DISTILLATION_MAX_CONCURRENT=3
# Characters of a conversation sent to the model.
# DISTILLATION_MAX_CONTENT_CHARS=8000
# Most summaries kept per conversation.
# DISTILLATION_MAX_FRAGMENTS=5
# Group related fragments into clusters.
# FRAGMENT_CLUSTERING_ENABLED=true
# Cosine similarity at or above which fragments are grouped.
# FRAGMENT_CLUSTER_THRESHOLD=0.80
# Fewest fragments that make a cluster.
# FRAGMENT_MIN_CLUSTER_SIZE=3
# Fewest distinct source types a cluster must span.
# FRAGMENT_MIN_SOURCE_DIVERSITY=2
# Most fragments one clustering run looks at.
# FRAGMENT_MAX_PER_CLUSTERING_RUN=2000
# Build the CI/CD capture analyzer at start (it uses the configured model). false leaves the CI capture endpoints without an analyzer.
# CI_ANALYZE_ENABLED=true

# ── Documentation Analytics ──
# Estimated minutes of engineer time saved per successfully answered query.
# VELOCITY_MINUTES_SAVED=15
# Hourly engineer cost in USD for ROI calculation.
# VELOCITY_HOURLY_RATE=75
# Bulk re-ingest guard for net knowledge velocity.
# VELOCITY_BULK_UPDATE_MULTIPLE=10.0
# Absolute ceiling on a single week's substantive (bulk-excluded) update contribution.
# VELOCITY_SUBSTANTIVE_UPDATE_CEILING=2000
# Use the current return-on-documentation method: needs enough distinct users, leaves out admins, caps each user's votes and recomputes from live data. false goes
# VELOCITY_ROI_V2_ENABLED=true
# Low end, in minutes, of the time saved per helpful answer.
# VELOCITY_ROI_MIN_MINUTES_LOW=5
# High end, in minutes, of the time saved per helpful answer.
# VELOCITY_ROI_MIN_MINUTES_HIGH=25
# Fewest distinct non-admin users with positive feedback in the window before any ROI is shown.
# VELOCITY_ROI_MIN_DISTINCT_USERS=3
# Leave admins' votes out of the ROI count, because the people who run the product rate it differently.
# VELOCITY_ROI_EXCLUDE_ADMIN=true
# Most votes from one user counted in the window, so a single enthusiastic user cannot dominate the figure.
# VELOCITY_ROI_MAX_VOTES_PER_USER=10
# Use the current tribal-knowledge method: a percentage over real domains, with a signal check. false goes back to the older fixed rule of two experts and no
# VELOCITY_TRIBAL_V2_ENABLED=true
# A domain with this many experts or fewer counts as tribal.
# VELOCITY_TRIBAL_MAX_EXPERTS=2
# Fewest domains with feedback signal before the tribal percentage is shown.
# VELOCITY_TRIBAL_MIN_DOMAINS=3
# Fewest snapshots with real activity (documents created or updated, or gap events) before the maintenance trend gives a verdict.
# VELOCITY_MAINTENANCE_TREND_MIN_SNAPSHOTS=4

# ── Knowledge Stream ──
# true runs the stream loop inside the server; the start-up log says Knowledge stream scheduled every N minutes or Knowledge stream disabled.
# STREAM_ENABLED=false
# Minutes between stream runs; 0 runs every minute.
# STREAM_INTERVAL_MINUTES=30
# Distinct users who must have asked the same troubleshooting question (or one answered with low confidence) within two hours before an incident early warning is
# STREAM_INCIDENT_WARNING_MIN_USERS=2
# Days; an expertise gap fires for a domain whose latest attribution is older than this and names two or fewer individuals.
# STREAM_EXPERTISE_GAP_DAYS=90

# ── Evidence Bundles ──
# Master switch for the evidence journal.
# EVIDENCE_ENABLED=true
# Emit a signed checkpoint after this many journal records.
# EVIDENCE_CHECKPOINT_EVERY_N=256
# Emit a signed checkpoint after this many seconds even if the record count hasn't reached EVIDENCE_CHECKPOINT_EVERY_N yet.
# EVIDENCE_CHECKPOINT_EVERY_SECS=3600
# Hex-encoded Ed25519 public key for the cold recovery key, declared at genesis.
# EVIDENCE_RECOVERY_PUBKEY=
# RFC 3161 timestamp authority endpoint.
# EVIDENCE_TSA_URL=
# Directory for append-only, dated witness files (witness-YYYY-MM-DD.jsonl) your organization publishes independently.
# EVIDENCE_WITNESS_DIR=

# ── Knowledge Health ──
# Seconds between scheduled engine runs — four runs a day, with the first one 60 seconds after boot.
# HEALTH_ENGINE_INTERVAL_SECS=21600
# The most findings that may be open at once, across the organisation.
# HEALTH_OPEN_CAP=10
# How far back a detector looks when counting the retrievals and questions that give a finding its impact.
# HEALTH_WINDOW_DAYS=30
# Public origin of the console, used to build each finding's deep link (<origin>/?finding=<id>).
# DOCBRAIN_PUBLIC_URL=

# ── Jira (INGEST_SOURCES=jira) ──
# Comma-separated project keys. e.g. PROJ,INFRA,PLATFORM.
# JIRA_PROJECTS=
# Extra JQL clause appended to the default query. e.g. priority = High
# JIRA_JQL_FILTER=
# How many days back to ingest resolved issues
# JIRA_LOOKBACK_DAYS=365
# Comma-separated issue types to include
# JIRA_ISSUE_TYPES=Bug,Story,Task,Epic

# ── Slack Threads (INGEST_SOURCES=slack_thread) ──
# Comma-separated channel names to index (leading # optional).
# SLACK_INGEST_CHANNELS=
# Minimum replies for a thread to be indexed (reply volume signals value)
# SLACK_INGEST_MIN_REPLIES=3
# Comma-separated reaction names that mark a thread indexable, regardless of reply count
# SLACK_INGEST_REACTIONS=white_check_mark,bookmark
# How far back to look for threads
# SLACK_INGEST_LOOKBACK_DAYS=90

# ── Slack Capture Access Control ──
# Comma-separated channel names (without #) or channel IDs that are allowed to use /docbrain capture.
# SLACK_CAPTURE_ALLOWED_CHANNELS=
# Comma-separated Slack usernames or user IDs allowed to trigger /docbrain capture.
# SLACK_CAPTURE_ALLOWED_USERS=

# ── Server ──
# Address the DocBrain API server binds to.
# SERVER_BIND=127.0.0.1
# Log verbosity and filter, in the tracing filter syntax: a level (trace, debug, info, warn, error) or per-module directives such as docbrain_core=debug,info.
# RUST_LOG=info
# json writes one JSON object per log line, for log aggregators.
# LOG_FORMAT=
# Days the notification feed keeps an entry.
# NOTIFICATION_RETENTION_DAYS=30
# Path to a subscription certificate file.
# DOCBRAIN_LICENSE_FILE=

# ── Background workers ──
# Seconds between runs of the behavioural-signal ingester.
# SIGNAL_INGEST_INTERVAL_SECS=900
# Seconds between runs of the expertise scorer.
# EXPERTISE_SCORER_INTERVAL_SECS=3600
# Seconds between refits of the expertise calibration model (the default is one week).
# CALIBRATION_REFIT_INTERVAL_SECS=604800
# Seconds between runs of the ownership-accuracy audit that decides whether confident attributions are shown. 0 leaves them hidden for good.
# UI_GATE_REFRESH_INTERVAL_SECS=300
# Seconds between identity-attestation snapshots (the default is one week).
# DOCBRAIN_ATTESTATION_INTERVAL_SECS=604800
# Seconds between passes that scan changed documents for secrets. 0 turns the pass off.
# SECRET_SCAN_INTERVAL_SECS=300

# ── Expertise ownership gate ──
# Lowest decayed team score that can publish.
# EXPERTISE_GATE_V_MIN=1.0
# Fewest raw signals that can publish.
# EXPERTISE_GATE_N_MIN=5
# Fewest distinct people who must have asked about the subject.
# EXPERTISE_GATE_M_ASKERS=2
# Fewest distinct signal types the evidence must come from.
# EXPERTISE_GATE_DIVERSITY_MIN=2
# How far the leading team must beat the second, as a fraction of the second's score.
# EXPERTISE_GATE_MARGIN_FRAC=0.25
# Master switch for showing confident ownership to people.
# EXPERTISE_GATE_UI_ENABLED=false
# Fewest audited confident attributions before the gate can open; with fewer it stays closed whatever the rate.
# EXPERTISE_GATE_UI_MIN_AUDIT_SAMPLES=30
# Highest audited confidently-wrong rate at which confident ownership is shown.
# EXPERTISE_GATE_UI_CONFIDENTLY_WRONG_BAR=0.0

# ── Reconciler ──
# Anything except false or 0 leaves the reconciler on, so a typo does not switch off the repair.
# RECONCILER_ENABLED=true
# Minutes between reconciler cycles.
# RECONCILER_INTERVAL_MINUTES=10
# The most documents or chunks one pass inspects per cycle.
# RECONCILER_BATCH_LIMIT=500

# ── Command-line client ──
# The fraction of a corpus that may disappear between two looks at the same server URL before the CLI says so.
# DOCBRAIN_CORPUS_DROP_ALERT=0.10
# How long docbrain generate waits for the server, in seconds.
# DOCBRAIN_GENERATE_TIMEOUT_SECS=900

# ── Event bus and outbound webhooks ──
# Seconds one webhook delivery attempt may take.
# WEBHOOK_DELIVERY_TIMEOUT_SECONDS=10
# Failed deliveries in a row after which a webhook subscription is switched off.
# WEBHOOK_CIRCUIT_BREAKER_THRESHOLD=10
# Delivery attempts, counting the first.
# WEBHOOK_MAX_RETRIES=4
# true or 1 lets a webhook target localhost or a private address.
# ALLOW_INTERNAL_WEBHOOKS=false

# ── Governance SLA checker ──
# Hours between runs of the checker.
# SLA_CHECKER_INTERVAL_HOURS=1
# Seconds the checker's database transaction may run.
# SLA_CHECKER_QUERY_TIMEOUT_SECS=30
# Most breaches announced in one run.
# SLA_CHECKER_MAX_EVENTS_PER_RUN=50

# ── Rate Limiting ──
# Failed login attempts allowed per IP per window before the IP is answered 429
# IP_LOGIN_MAX_FAILURES=100
# Length of that window in seconds; also the Retry-After value on the 429
# IP_LOGIN_LOCKOUT_WINDOW_SECS=600

# ── Auth / Sessions ──
# Longest life, in days, of an API key a person creates for themselves and of an app connection made with Sign-in for apps.
# MAX_PAT_DAYS=90
# Requests per minute for a login session key.
# SESSION_RATE_LIMIT_RPM=240
# Where to write the admin bootstrap key on first boot
# ADMIN_KEY_FILE=/app/admin-bootstrap-key.txt
# Hours without use after which an API key is rejected as if expired, whatever its lifetime. 0 turns it off.
# IDLE_TIMEOUT_HOURS=0
# false, 0, no or off revokes the bootstrap admin key at start and keeps it revoked; if the revoke fails the server refuses to start.
# BOOTSTRAP_KEY_ENABLED=true
# Pre-set value for the bootstrap admin key on first boot, as the Helm chart's initial-admin secret does.
# BOOTSTRAP_ADMIN_KEY=

# ── Access lists at ingest ──
# How Confluence page access is carried into answers. off records no access list. mirror copies each page's Confluence permissions, so people only see pages they
# ACL_CONFLUENCE_MODE=off
# How access to GitHub documents (captures, pull requests and other GitHub documents) is carried into answers.
# ACL_GITHUB_MODE=off
# How access to Slack documents (threads and captures) is carried into answers.
# ACL_SLACK_MODE=off
# How access to Jira issues is carried into answers.
# ACL_JIRA_MODE=off
# Token used to read who can see a GitHub document during ingest when GITHUB_TOKEN is not set.
# GITHUB_CAPTURE_TOKEN=
# Seconds between reads of who belongs to each Confluence space and group and each Slack channel, which access decisions are made from. 0 turns the sweep off.
# ACCESS_MEMBERSHIP_SWEEP_SECS=240
# Seconds between reads of who can open each Confluence page and Jira issue. 0 turns the sweep off.
# ACCESS_STATE_SWEEP_SECS=900

# ── Access lists at query time ──
# Whether answers are filtered by who may read each source. off applies no filter. warn works out what would be filtered and logs it, but keeps every result, so
# ACL_MODE=off
# What to do with a chunk that carries no access list: deny or allow.
# ACL_UNKNOWN_POLICY=deny
# Declared as the factor by which the search top_k is raised while the filter is active, but no code reads it yet, so changing it has no effect.
# ACL_RECALL_OVERFETCH=1.0
# Seconds after which a person's stored group memberships count as stale and are left out of what they may read. 0 turns this check off.
# ACL_USER_PRINCIPAL_MAX_AGE_SECS=3600
# What an answer says when access filtering removed content. silent gives generic text and no counts. disclosed_no_count says a filter was applied without saying
# ACL_DENIAL_MODE=disclosed_no_count
# Who the denial text tells people to contact; it fills <referral> in the message.
# ACL_DENIAL_REFERRAL=
# true writes a row to the acl_audit_log table whenever a denial removed content, for compliance review.
# ACL_DENIAL_AUDIT=false
# true stores the question text in the audit log.
# ACL_DENIAL_AUDIT_RAW_QUERY=false

# ── Access-list backfill tool ──
# Which source to backfill.
# ACL_BACKFILL_SOURCE=confluence
# Most documents to process in one run. 0 means no limit.
# ACL_BACKFILL_LIMIT=0
# true or 1 fetches and overwrites access lists that already exist.
# ACL_BACKFILL_FORCE=false
# Limit the run to one space key.
# ACL_BACKFILL_SPACE=

# ── Restoring removed secrets from a backup ──
# Connection string of the database restored from the backup.
# BACKUP_DATABASE_URL=

# ── MCP Tool Platform ──
# Master switch. true = orchestrator runs after retrieval, injects live-tool blocks into the synthesis prompt.
# MCP_TOOLS_ENABLED=false
# Required to load the shipped in-process shim manifests. confluence_rest and jira_rest are served by docbrain-server itself at
# DOCBRAIN_SSRF_ALLOW_LOOPBACK_FOR_INTERNAL_SHIMS=
# Base64-encoded 32-byte Ed25519 public key used to verify the signed registry index and per-manifest signatures.
# MCP_REGISTRY_PUBKEY=
# URL of the signed registry index.
# MCP_REGISTRY_URL=https://registry.docbrain-ai.com/v1/index.json
# Disk path for the cached registry index.
# MCP_REGISTRY_CACHE_PATH=/var/lib/docbrain/registry-cache/index.json
# Kubernetes Secret name embedded in the kubectl command rendered by /api/v1/admin/mcp/secrets/audit/{id}.
# DOCBRAIN_K8S_SECRET_NAME=
# Kubernetes namespace for the same audit endpoint.
# DOCBRAIN_K8S_NAMESPACE=
# Origin that MCP sign-in (OAuth) uses to build its callback address.
# DOCBRAIN_PUBLIC_BASE_URL=http://localhost:3000
# Base64 key of exactly 32 bytes that encrypts stored per-user tool sign-in tokens.
# MCP_OAUTH_ENCRYPTION_KEY=
# Directory the tool manifests are read from.
# MCP_MANIFEST_DIR=/etc/docbrain/manifests
# Base64 key of 32 bytes that encrypts secrets typed into a manifest in the console.
# DOCBRAIN_MCP_SECRET_KEY=
# Bearer secret the built-in tool shims require from the orchestrator, which calls them on the loopback address; generated at start when unset (a temporary one
# DOCBRAIN_INTERNAL_MCP_SECRET=
# What happens to direct-message content returned by a tool (today, Slack). strict removes it before it reaches the answer, the cache or memory. warn logs it but
# DOCBRAIN_DM_PERSIST_POLICY=strict
# 1, true, yes or on logs how each tool result was framed in the answer prompt: the header, the argument line and the sizes, never the body.
# DOCBRAIN_MCP_LOG_RENDERED_BLOCKS=false
# Diagnostic only, off by default. true, 1, yes or on logs a warning for each Slack tool call with the first part of the parsed response and the redaction report.
# DOCBRAIN_DM_REDACTOR_DEBUG_PROBE=false
# Diagnostic only, off by default. true logs the full authorize URL on every tool sign-in, and, when a token exchange cannot be decoded, the first part of the
# DOCBRAIN_OAUTH_EXCHANGE_DEBUG_PROBE=false

# ── Generic OIDC (Google, Okta, Auth0, Azure AD, Keycloak, …) ──
# Where to redirect the browser after a successful login; most deployments leave it unset. default: DOCBRAIN_WEB_BASE_URL, else http://localhost:3001
# OIDC_WEB_UI_URL=
# Set to true to skip TLS verification for OIDC discovery.
# OIDC_ACCEPT_INVALID_CERTS=false

# ── GitHub OAuth 2.0 ──
# GitHub OAuth App client ID
# GITHUB_CLIENT_ID=
# GitHub OAuth App client secret
# GITHUB_CLIENT_SECRET=
# Callback URL. e.g. https://docbrain.co/api/v1/auth/github/callback
# GITHUB_REDIRECT_URI=

# ── GitLab OIDC ──
# GitLab instance URL. e.g. https://gitlab.com or https://gitlab.corp.example.com
# GITLAB_OIDC_ISSUER_URL=
# GitLab application client ID
# GITLAB_CLIENT_ID=
# GitLab application client secret
# GITLAB_CLIENT_SECRET=
# Callback URL. e.g. https://docbrain.co/api/v1/auth/gitlab/callback
# GITLAB_REDIRECT_URI=

# ── Who may sign in ──
# Comma-separated IdP group names, or GitHub organisations, allowed to sign in.
# OIDC_ALLOWED_GROUPS=
# Comma-separated email domains allowed to sign in, for example acme.com,acme.org.
# OIDC_ALLOWED_DOMAINS=
# true or 1 lets a first SSO login attach to an existing local account with the same email, but only when the IdP reports that email as verified.
# OIDC_ALLOW_EMAIL_LINKING=false

# ── RBAC Role Mapping ──
# Default role for new SSO users: viewer, editor, or admin
# OIDC_DEFAULT_ROLE=viewer
# Email domain that grants admin. e.g. mycompany.com
# OIDC_ADMIN_DOMAIN=
# Comma-separated emails that always get admin
# OIDC_ADMIN_EMAILS=
# Comma-separated IdP group names → admin
# OIDC_ADMIN_GROUPS=
# Comma-separated IdP group names → editor
# OIDC_EDITOR_GROUPS=
# Comma-separated IdP group names → analyst (the role between editor and admin: it can moderate answers and fragments)
# OIDC_ANALYST_GROUPS=
# Set false or 0 to stop the IdP rewriting an existing user's role at each login, so a role an admin set in DocBrain survives.
# OIDC_SYNC_ROLE_ON_LOGIN=true
# <<< generated <<<
