.env
# scripts/setup.sh edits .env with sed -i.bak; the backup holds the same API keys.
.env.bak
config/local.yaml
# scripts/setup.sh keeps the previous config/local.yaml as config/local.yaml.bak.<UTC time> before each rewrite;
# each holds the same credentials. The bare name is the backup earlier versions of the wizard wrote.
config/local.yaml.bak*
*.log
.DS_Store
node_modules/

# IDE / AI tools (may contain API keys)
.claude/
.idea/
.vscode/
.cursor/
.mcp.json
# The plugin eval suite's stand-in connection: a fixed local address, no key (plugin-evals/docbrain/evals/README.md).
!plugin-evals/docbrain/.mcp.json

# Rust build artifacts
target/

# Python bytecode. Running tools/verify_dbev.py writes tools/__pycache__/,
# and nothing should ever commit it.
__pycache__/
*.pyc
