.env
# scripts/setup.sh edits .env with sed -i.bak; the backup holds the same API keys.
.env.bak
config/local.yaml
*.log
.DS_Store
node_modules/

# IDE / AI tools (may contain API keys)
.claude/
.idea/
.vscode/
.cursor/
.mcp.json

# Rust build artifacts
target/

# Python bytecode. Running tools/verify_dbev.py writes tools/__pycache__/,
# and nothing should ever commit it.
__pycache__/
*.pyc
