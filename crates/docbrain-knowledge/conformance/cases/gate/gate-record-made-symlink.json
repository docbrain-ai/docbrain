{
  "id": "gate-record-made-symlink",
  "spec": "The gate, changed: a record replaced by a symlink is invalid at its path",
  "op": "gate",
  "base": {
    ".knowledge/records/a.md": "---\nknowledge: 1\nid: 'k3v9q2x7m001'\nkind: 'decision'\ntitle: 't1'\nchecks:\n  - config_key: 'v.yaml#replicas'\n    must: '>= 2'\n---\nWhy 1.\n",
    "v.yaml": "replicas: 3\n"
  },
  "tree": {
    ".knowledge/records/a.md": {
      "symlink": "elsewhere.md"
    },
    "v.yaml": "replicas: 3\n"
  },
  "expect": {
    "findings": [
      {
        "class": "changed",
        "change": "invalid",
        "id": "k3v9q2x7m001",
        "record": ".knowledge/records/a.md",
        "anchor": "v.yaml#replicas",
        "reasons": [
          "invalid"
        ]
      }
    ],
    "knowledge": {
      "edited": [
        ".knowledge/records/a.md"
      ]
    }
  }
}
